  "timezone": "Australia/Sydney",
  "cadence": {
    "days": [
      "Monday",
      "Wednesday",
      "Friday"
    ],
    "localTime": "10:00",
    "articlesPerRun": 1,
    "articlesPerWeek": 3
  },
  "authority": {
    "allowedRisk": "R2",
    "branchPrefix": "ai/daily-content-",
    "exactArticlesPerChange": 1,
    "proposalApprover": "seo-policy-bot",
    "requiredCheck": "Type, content, security, build and route checks",
    "postDeployAuditRequired": true,
    "deterministicRollbackAllowed": true,
    "qualityReviewRequired": true,
    "minimumQualityScore": 85,
    "qualityContractVersion": 1,
    "automatedContentRisk": "low"
  },
  "requiredGates": [
    "one approved low-risk R2 proposal with complete evidence, measurement and articleQualityReview score of at least 85",
    "no existing registry page mutation",
    "content quality and financial-claim checks",
    "typecheck, lint, unit tests, dependency audit, build and prerender",
    "route, canonical, sitemap, noindex, schema, accessibility and Lighthouse checks"
  ],
  "forbidden": [
    "publishing more or fewer than one article in one automated change",
    "R3 or R4 changes",
    "external outreach or email sending",
    "merging after any failed or missing gate",
    "recording a human as the automated proposal approver"
  ],
